{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fangcun.invalid/schema/protocol-v1.json",
  "title": "Fangcun wire protocol v1 partial runtime contract",
  "description": "JSON Schema for currently implemented envelopes. Welcome snapshot cells are semantically validated by TypeScript runtime code.",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/intent" },
    { "$ref": "#/$defs/resync" },
    { "$ref": "#/$defs/approvePlan" },
    { "$ref": "#/$defs/ping" },
    { "$ref": "#/$defs/welcome" },
    { "$ref": "#/$defs/ackAccepted" },
    { "$ref": "#/$defs/ackRejected" },
    { "$ref": "#/$defs/commit" },
    { "$ref": "#/$defs/pong" },
    { "$ref": "#/$defs/approvalGranted" }
  ],
  "$defs": {
    "version": { "const": 1 },
    "worldId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "coord": { "type": "object", "additionalProperties": false, "required": ["x", "y", "z"], "properties": { "x": { "type": "integer" }, "y": { "type": "integer" }, "z": { "type": "integer" } } },
    "operation": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "at", "blockId"], "properties": { "type": { "const": "place" }, "at": { "$ref": "#/$defs/coord" }, "blockId": { "enum": ["grass", "dirt", "stone", "planks", "log", "leaves", "sand", "glass", "brick", "tile", "wool_white", "wool_red", "bookshelf", "lantern", "pumpkin", "flower"] } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "at", "expectedBlock"], "properties": { "type": { "const": "break" }, "at": { "$ref": "#/$defs/coord" }, "expectedBlock": { "enum": ["grass", "dirt", "stone", "planks", "log", "leaves", "sand", "glass", "brick", "tile", "wool_white", "wool_red", "bookshelf", "lantern", "pumpkin", "flower"] } } }
      ]
    },
    "hello": { "type": "object", "additionalProperties": false, "required": ["protocolVersion", "type", "worldId", "clientId", "credential", "lastAppliedRev"], "properties": { "protocolVersion": { "$ref": "#/$defs/version" }, "type": { "const": "hello" }, "worldId": { "$ref": "#/$defs/worldId" }, "clientId": { "type": "string", "minLength": 1, "maxLength": 128 }, "credential": { "type": "string", "minLength": 1, "maxLength": 512 }, "lastAppliedRev": { "type": "integer", "minimum": 0 } } },
    "intent": { "type": "object", "additionalProperties": false, "required": ["protocolVersion", "type", "worldId", "clientId", "seq", "baseRev", "operation"], "properties": { "protocolVersion": { "$ref": "#/$defs/version" }, "type": { "const": "intent" }, "worldId": { "$ref": "#/$defs/worldId" }, "clientId": { "type": "string", "minLength": 1, "maxLength": 128 }, "seq": { "type": "integer", "minimum": 1 }, "baseRev": { "type": "integer", "minimum": 0 }, "operation": { "$ref": "#/$defs/operation" } } },
    "resync": { "type": "object", "additionalProperties": false, "required": ["protocolVersion", "type", "worldId", "lastAppliedRev"], "properties": { "protocolVersion": { "$ref": "#/$defs/version" }, "type": { "const": "resync" }, "worldId": { "$ref": "#/$defs/worldId" }, "lastAppliedRev": { "type": "integer", "minimum": 0 } } },
    "approvePlan": { "type": "object", "additionalProperties": false, "required": ["protocolVersion", "type", "worldId", "planId", "diffHash", "shownBaseRev"], "properties": { "protocolVersion": { "$ref": "#/$defs/version" }, "type": { "const": "approve_plan" }, "worldId": { "$ref": "#/$defs/worldId" }, "planId": { "type": "string", "minLength": 1, "maxLength": 128 }, "diffHash": { "type": "string", "minLength": 1, "maxLength": 256 }, "shownBaseRev": { "type": "integer", "minimum": 0 } } },
    "ping": { "type": "object", "additionalProperties": false, "required": ["protocolVersion", "type", "worldId", "nonce"], "properties": { "protocolVersion": { "$ref": "#/$defs/version" }, "type": { "const": "ping" }, "worldId": { "$ref": "#/$defs/worldId" }, "nonce": { "type": "string", "minLength": 1, "maxLength": 64 } } },
    "welcome": { "type": "object", "additionalProperties": false, "required": ["protocolVersion", "type", "worldId", "rev", "snapshot", "worldSchemaHash", "blockCatalogHash"], "properties": { "protocolVersion": { "$ref": "#/$defs/version" }, "type": { "const": "welcome" }, "worldId": { "$ref": "#/$defs/worldId" }, "rev": { "type": "integer", "minimum": 0 }, "snapshot": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "worldId", "rev", "blocks"], "properties": { "schemaVersion": { "const": 1 }, "worldId": { "$ref": "#/$defs/worldId" }, "rev": { "type": "integer", "minimum": 0 }, "blocks": { "type": "array", "minItems": 4096, "maxItems": 4096, "items": { "type": ["string", "null"], "enum": ["grass", "dirt", "stone", "planks", "log", "leaves", "sand", "glass", "brick", "tile", "wool_white", "wool_red", "bookshelf", "lantern", "pumpkin", "flower", null] } } } }, "worldSchemaHash": { "type": "string", "minLength": 1, "maxLength": 256 }, "blockCatalogHash": { "type": "string", "minLength": 1, "maxLength": 256 } } },
    "ackAccepted": { "type": "object", "additionalProperties": false, "required": ["protocolVersion", "type", "worldId", "seq", "accepted", "committedRev"], "properties": { "protocolVersion": { "$ref": "#/$defs/version" }, "type": { "const": "ack" }, "worldId": { "$ref": "#/$defs/worldId" }, "seq": { "type": "integer", "minimum": 1 }, "accepted": { "const": true }, "committedRev": { "type": "integer", "minimum": 0 } } },
    "ackRejected": { "type": "object", "additionalProperties": false, "required": ["protocolVersion", "type", "worldId", "seq", "accepted", "reason", "committedRev"], "properties": { "protocolVersion": { "$ref": "#/$defs/version" }, "type": { "const": "ack" }, "worldId": { "$ref": "#/$defs/worldId" }, "seq": { "type": "integer", "minimum": 1 }, "accepted": { "const": false }, "reason": { "type": "string", "minLength": 1, "maxLength": 128 }, "committedRev": { "type": "integer", "minimum": 0 } } },
    "commit": { "type": "object", "additionalProperties": false, "required": ["protocolVersion", "type", "worldId", "rev", "txId", "actor", "operations"], "properties": { "protocolVersion": { "$ref": "#/$defs/version" }, "type": { "const": "commit" }, "worldId": { "$ref": "#/$defs/worldId" }, "rev": { "type": "integer", "minimum": 1 }, "txId": { "type": "string", "minLength": 1, "maxLength": 128 }, "actor": { "enum": ["player", "ai", "system"] }, "operations": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/operation" } } } },
    "pong": { "type": "object", "additionalProperties": false, "required": ["protocolVersion", "type", "worldId", "nonce"], "properties": { "protocolVersion": { "$ref": "#/$defs/version" }, "type": { "const": "pong" }, "worldId": { "$ref": "#/$defs/worldId" }, "nonce": { "type": "string", "minLength": 1, "maxLength": 64 } } },
    "approvalGranted": { "type": "object", "additionalProperties": false, "required": ["protocolVersion", "type", "worldId", "planId", "approvalId", "diffHash", "expiresAt"], "properties": { "protocolVersion": { "$ref": "#/$defs/version" }, "type": { "const": "approval_granted" }, "worldId": { "$ref": "#/$defs/worldId" }, "planId": { "type": "string", "minLength": 1, "maxLength": 128 }, "approvalId": { "type": "string", "minLength": 1, "maxLength": 128 }, "diffHash": { "type": "string", "minLength": 1, "maxLength": 256 }, "expiresAt": { "type": "integer", "minimum": 1 } } }
  }
}
