{
  "name": "fangcun",
  "version": "0.1.0",
  "private": true,
  "description": "桌面 AR 微缩方块世界：共享世界模型与体素核心",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "typecheck": "npm run build && tsc -p tsconfig.tests.json --pretty false",
    "build": "tsc -b --pretty false --force",
    "pretest": "npm run build",
    "test": "node --experimental-strip-types --test tests/unit/**/*.test.ts tests/contracts/**/*.test.mjs",
    "test:unit": "node --experimental-strip-types --test tests/unit/**/*.test.ts",
    "test:contracts": "node --test tests/contracts/**/*.test.mjs",
    "test:browser": "node tests/browser/test-simulator.mjs && node tests/browser/test-core-ui.mjs",
    "host": "npm run build && node scripts/run-host.mjs",
    "mcp": "npm run build && node scripts/mcp-server.mjs",
    "simulator": "npm run build && node scripts/serve-simulator.mjs",
    "atlas": "node scripts/build-block-atlas.mjs",
    "demo:companion": "npm run build && node scripts/demo-companion.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "puppeteer-core": "^25.17.0",
    "typescript": "^5.9.3"
  }
}
